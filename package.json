{
  "name": "pretty-http-client",
  "version": "2.0.0",
  "description": "A tiny, zero-dependency fetch client with hooks, retries, timeouts, and LRU response caching.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm typecheck && pnpm coverage && pnpm build"
  },
  "keywords": [
    "typescript",
    "http",
    "fetch",
    "retry",
    "cache"
  ],
  "author": "jacob.jiang",
  "repository": {
    "type": "git",
    "url": "https://github.com/oloshe/pretty-http-client.git"
  },
  "license": "ISC",
  "devDependencies": {
    "@vitest/coverage-v8": "2.1.8",
    "typescript": "^5.5.4",
    "vite": "^6.0.3",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "2.1.8"
  }
}
